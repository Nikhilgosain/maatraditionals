    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.2.0",
    "@mui/x-date-pickers": "^8.9.2",
    "@react-pdf/renderer": "^4.3.0",
    "@sparticuz/chromium": "^138.0.2",
    "@types/react-select": "^5.0.1",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.1",
    "jose": "^6.0.12",
    "jsonwebtoken": "^9.0.2",
