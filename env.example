# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your_bucket_name

# MongoDB Configuration (existing)
MONGODB_URI=your_mongodb_connection_string

# JWT Configuration (existing)
JWT_SECRET=your_jwt_secret_key

# Optional emergency admin account. Use a unique, strong password in Render.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# Optional only when the frontend and API are hosted on different origins.
# Leave unset for a single Render Web Service; requests will use the current origin.
NEXT_PUBLIC_APP_BASE_URL=
